{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Studio public article metadata",
  "type": "object",
  "required": ["schemaVersion", "slug", "title", "description", "status", "publicSafe", "author", "category", "createdAt", "updatedAt", "tags", "coverImage", "coverAlt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "published", "archived"]},
    "publicSafe": {"const": true},
    "author": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date"},
    "updatedAt": {"type": "string", "format": "date"},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coverImage": {"type": "string", "pattern": "^assets/[a-zA-Z0-9_.-]+\\.(svg|png|jpg|jpeg|webp)$"},
    "coverAlt": {"type": "string", "minLength": 1},
    "sourceType": {"enum": ["topic", "notion", "mixed"]},
    "publishedUrl": {"type": ["string", "null"], "format": "uri"},
    "featured": {"type": "boolean"},
    "socialImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt", "width", "height", "type"],
      "properties": {
        "path": {"type": "string", "pattern": "^assets/[a-zA-Z0-9_.-]+\\.(png|jpg|jpeg)$"},
        "alt": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "type": {"enum": ["image/png", "image/jpeg"]}
      }
    }
  }
}
